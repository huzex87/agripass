# Server Port Configuration
PORT=3002

# Database URLs
MONGODB_URL=mongodb://localhost:27017/agripass

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Configuration (for project banner/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment
NODE_ENV=development

# CORS: comma-separated list of extra allowed production origins (the client's
# own domain(s)). agripass-client.vercel.app is allowed by default.
ALLOWED_ORIGINS=https://your-frontend-domain.com
# Suffix used to allow this project's Vercel preview deployments only.
VERCEL_PREVIEW_SUFFIX=-huzex87-9264s-projects.vercel.app

# Secret shared with Vercel Cron to authorize the overdue-sweep endpoint.
# Set the same value in the Vercel project's Environment Variables.
CRON_SECRET=your_long_random_cron_secret

# SMS notifications (Termii). Leave TERMII_API_KEY unset to disable SMS
# entirely — the platform runs fine without it (sends become no-ops).
TERMII_API_KEY=
TERMII_SENDER_ID=AgriPass
