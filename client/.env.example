# Base URL of the AgriPass backend API.
#
# REQUIRED in every deployed environment. The client and server are deployed
# as SEPARATE apps, so the browser cannot reach the API on its own origin.
#
# - Local development:   VITE_API_URL=http://localhost:3002
# - Production (Vercel):  VITE_API_URL=https://<your-server-app>.vercel.app
#
# IMPORTANT:
#   * In production this MUST be an https:// URL. Pointing an https:// site at
#     an http:// API triggers browser "mixed content" blocking, which surfaces
#     to users as a generic "Login failed. Please check your credentials" error.
#   * If this is left unset, requests fall back to same-origin "/", which on the
#     static client deployment resolves to the SPA itself and breaks all API
#     calls (login included).
#   * Set this in the client Vercel project's Environment Variables and redeploy;
#     Vite inlines it at build time, so a redeploy is required after changing it.
VITE_API_URL=http://localhost:3002
